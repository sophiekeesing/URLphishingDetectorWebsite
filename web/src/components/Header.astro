---
import { getCurrentUser } from "../lib/api";

const cookieHeader = Astro.request.headers.get("cookie");
const user = await getCurrentUser(cookieHeader);

const navLinks = [
  { href: "/#features", label: "Features" },
  { href: "/#pricing", label: "Pricing" },
  { href: "/#download", label: "Download" },
];
---

<header class="border-b border-slate-100">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-2 font-extrabold text-lg tracking-tight">
			<img src="/logo-mark.svg" alt="" class="h-7 w-6" aria-hidden="true" />
			Chick Check
		</a>

		<nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
			{navLinks.map((link) => (
				<a href={link.href} class="hover:text-slate-900 transition-colors">{link.label}</a>
			))}
		</nav>

		<div class="flex items-center gap-3">
			{user ? (
				<a
					href="/account"
					class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 transition-colors"
				>
					My account
				</a>
			) : (
				<>
					<a href="/login" class="text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors">
						Log in
					</a>
					<a
						href="/register"
						class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 transition-colors"
					>
						Sign up free
					</a>
				</>
			)}
		</div>
	</div>
</header>
