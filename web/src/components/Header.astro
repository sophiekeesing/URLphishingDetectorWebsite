---
import { getCurrentUser } from "../lib/api";

const cookieHeader = Astro.request.headers.get("cookie");
const user = await getCurrentUser(cookieHeader);

const navLinks = [
  { href: "/#features", label: "Features" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#about", label: "About us" },
  { href: "/#download", label: "Download" },
];
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white">
	<div class="grid w-full grid-cols-[auto_1fr_auto] items-center gap-4 px-6 py-4 sm:px-10 lg:px-16">
		<a href="/" class="flex items-center">
			<img src="/logo.svg" alt="Chick-Check" class="h-14 w-auto" />
		</a>

		<nav class="hidden md:flex items-center justify-center gap-1 rounded-full bg-slate-100 px-2 py-2 text-sm font-medium text-slate-600 justify-self-center">
			{navLinks.map((link) => (
				<a href={link.href} class="rounded-full px-4 py-2 hover:bg-white hover:text-slate-900 transition-colors">{link.label}</a>
			))}
		</nav>

		<div class="flex items-center justify-end gap-3">
			{user ? (
				<a
					href="/account"
					class="rounded-full bg-[#44B695] px-4 py-2 text-sm font-semibold uppercase tracking-wide text-white hover:bg-[#369278] transition-colors"
				>
					My account
				</a>
			) : (
				<>
					<a href="/login" class="text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors">
						Log in
					</a>
					<a
						href="/register"
						class="rounded-full bg-[#44B695] px-4 py-2 text-sm font-semibold uppercase tracking-wide text-white hover:bg-[#369278] transition-colors"
					>
						Sign up free
					</a>
				</>
			)}
		</div>
	</div>
</header>
