---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact us" description="Get in touch with the Chick-Check team.">
	<section class="mx-auto max-w-3xl px-6 py-20">
		<h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Contact us</h1>
		<p class="mt-6 text-slate-600">
			Have a question, found a bug, or want to report a site Chick-Check missed? We'd like to hear from you.
		</p>
		<p class="mt-4 text-slate-600">
			Contact details are on the way. Check back soon.
		</p>
	</section>
</Layout>
