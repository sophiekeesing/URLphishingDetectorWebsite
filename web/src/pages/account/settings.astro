---
import AccountLayout from "../../layouts/AccountLayout.astro";
import { apiFetch, getCurrentUser } from "../../lib/api";
import { features } from "../../lib/content";

const cookieHeader = Astro.request.headers.get("cookie");
const user = await getCurrentUser(cookieHeader);
if (!user) return Astro.redirect("/login");

const settingsRes = await apiFetch("/api/settings", cookieHeader);
const settings: Record<string, boolean> = settingsRes.ok ? await settingsRes.json() : {};
---

<AccountLayout title="Extension settings" user={user}>
	<h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Extension settings</h1>
	<p class="mt-2 text-slate-600">Choose which Chick Check protections are active in your browser. Changes sync to the extension automatically.</p>

	<p id="save-status" class="mt-4 hidden text-sm font-medium text-safe-500">Saved</p>

	<div class="mt-6 divide-y divide-slate-200 rounded-2xl border border-slate-200">
		{features.map((feature) => (
			<label class="flex items-start gap-4 p-5 cursor-pointer">
				<input
					type="checkbox"
					data-feature-key={feature.key}
					checked={Boolean(settings[feature.key])}
					class="mt-1 h-5 w-5 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
				/>
				<span>
					<span class="flex items-center gap-2 font-semibold text-slate-900">
						<span aria-hidden="true">{feature.icon}</span>
						{feature.title}
					</span>
					<span class="mt-1 block text-sm text-slate-600">{feature.description}</span>
				</span>
			</label>
		))}
	</div>

	<script>
		import { API_URL } from "../../lib/api";

		const saveStatus = document.getElementById("save-status") as HTMLParagraphElement;
		let hideTimeout: ReturnType<typeof setTimeout>;

		document.querySelectorAll<HTMLInputElement>("input[data-feature-key]").forEach((input) => {
			input.addEventListener("change", async () => {
				const key = input.dataset.featureKey!;
				const res = await fetch(`${API_URL}/api/settings`, {
					method: "PATCH",
					headers: { "Content-Type": "application/json" },
					credentials: "include",
					body: JSON.stringify({ [key]: input.checked }),
				});

				if (!res.ok) {
					input.checked = !input.checked;
					return;
				}

				clearTimeout(hideTimeout);
				saveStatus.classList.remove("hidden");
				hideTimeout = setTimeout(() => saveStatus.classList.add("hidden"), 2000);
			});
		});
	</script>
</AccountLayout>
