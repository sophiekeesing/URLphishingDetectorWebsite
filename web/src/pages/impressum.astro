---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Impressum" description="Legal notice for Chick-Check.">
	<section class="mx-auto max-w-3xl px-6 py-20">
		<h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Impressum</h1>
		<p class="mt-6 text-slate-600">
			Legal notice details (provider, contact, and register information) are on the way. Check back soon.
		</p>
	</section>
</Layout>
