---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contribute" description="How to contribute to Chick-Check.">
	<section class="mx-auto max-w-3xl px-6 py-20">
		<h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Contribute</h1>
		<p class="mt-6 text-slate-600">
			Chick-Check gets better with help from people who use it — reporting scam sites, suggesting features,
			and pointing out what's confusing or missing.
		</p>
		<p class="mt-4 text-slate-600">
			Details on how to get involved are on the way. Check back soon.
		</p>
	</section>
</Layout>
