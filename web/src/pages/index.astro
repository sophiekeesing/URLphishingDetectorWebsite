---
import Layout from "../layouts/Layout.astro";
import { features, plans } from "../lib/content";
---

<Layout title="Catch phishing links before you click">
	<!-- Hero -->
	<section class="mx-auto max-w-6xl px-6 pt-20 pb-24 grid gap-12 lg:grid-cols-2 lg:items-center">
		<div>
			<span class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-700">
				🐤 Free browser extension
			</span>
			<h1 class="mt-6 text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
				Catch scam links before they catch you.
			</h1>
			<p class="mt-6 text-lg text-slate-600">
				Chick Check watches the links, forms, and downloads on the pages you visit and warns you the moment
				something looks like phishing — before you click, type, or download anything.
			</p>
			<div id="download" class="mt-8 flex flex-wrap gap-4">
				<a
					href="#"
					class="rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700 transition-colors"
				>
					Add to Chrome — it's free
				</a>
				<a
					href="#"
					class="rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-800 hover:border-slate-400 transition-colors"
				>
					Add to Firefox
				</a>
			</div>
			<p class="mt-3 text-xs text-slate-400">Free forever plan. No credit card required.</p>
		</div>

		<div class="relative">
			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/60">
				<div class="flex items-center gap-2 text-xs text-slate-400">
					<span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
					<span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
					<span class="ml-2 truncate">secure-paypa1-login.com</span>
				</div>
				<div class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4">
					<p class="flex items-center gap-2 font-semibold text-red-700">
						<span aria-hidden="true">⚠️</span> Chick Check blocked this page
					</p>
					<p class="mt-2 text-sm text-red-600">
						This site's domain closely mimics <strong>paypal.com</strong> and was reported as a phishing
						target. Entering your login here is not recommended.
					</p>
					<div class="mt-4 flex gap-3 text-sm font-semibold">
						<span class="rounded-full bg-red-600 px-4 py-2 text-white">Leave this site</span>
						<span class="rounded-full border border-red-300 px-4 py-2 text-red-700">Details</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section id="features" class="bg-slate-50 py-24">
		<div class="mx-auto max-w-6xl px-6">
			<div class="max-w-2xl">
				<h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Everything watching your back</h2>
				<p class="mt-4 text-slate-600">
					Every feature below can be switched on or off from your account settings once you're signed in —
					Chick Check adapts to how you browse.
				</p>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{features.map((feature) => (
					<div class="rounded-2xl border border-slate-200 bg-white p-6">
						<span class="text-2xl" aria-hidden="true">{feature.icon}</span>
						<h3 class="mt-4 font-semibold text-slate-900">{feature.title}</h3>
						<p class="mt-2 text-sm text-slate-600">{feature.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="py-24">
		<div class="mx-auto max-w-6xl px-6">
			<h2 class="text-3xl font-extrabold tracking-tight text-slate-900">How it works</h2>
			<div class="mt-12 grid gap-10 sm:grid-cols-3">
				<div>
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 font-bold text-brand-700">1</div>
					<h3 class="mt-4 font-semibold text-slate-900">Install the extension</h3>
					<p class="mt-2 text-sm text-slate-600">Add Chick Check to Chrome or Firefox in a few seconds — no account required to start.</p>
				</div>
				<div>
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 font-bold text-brand-700">2</div>
					<h3 class="mt-4 font-semibold text-slate-900">Browse as usual</h3>
					<p class="mt-2 text-sm text-slate-600">Chick Check quietly checks links, login forms, and downloads in the background.</p>
				</div>
				<div>
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 font-bold text-brand-700">3</div>
					<h3 class="mt-4 font-semibold text-slate-900">Get warned in time</h3>
					<p class="mt-2 text-sm text-slate-600">A clear warning pops up before you land on, or interact with, a suspicious page.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section id="pricing" class="bg-slate-50 py-24">
		<div class="mx-auto max-w-6xl px-6">
			<div class="max-w-2xl">
				<h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Simple pricing</h2>
				<p class="mt-4 text-slate-600">Start free. Upgrade any time from your account for the full feature set.</p>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 max-w-3xl">
				{plans.map((plan) => (
					<div class={`rounded-2xl border p-8 ${plan.id === "pro" ? "border-brand-400 bg-white shadow-lg" : "border-slate-200 bg-white"}`}>
						<h3 class="font-semibold text-slate-900">{plan.name}</h3>
						<p class="mt-4 flex items-baseline gap-1">
							<span class="text-3xl font-extrabold text-slate-900">{plan.price}</span>
							<span class="text-sm text-slate-500">{plan.cadence}</span>
						</p>
						<p class="mt-2 text-sm text-slate-600">{plan.description}</p>
						<ul class="mt-6 space-y-2 text-sm text-slate-700">
							{plan.featureKeys.map((key) => {
								const feature = features.find((f) => f.key === key);
								return feature ? (
									<li class="flex items-start gap-2">
										<span class="text-safe-500" aria-hidden="true">✓</span>
										{feature.title}
									</li>
								) : null;
							})}
						</ul>
						<a
							href="/register"
							class={`mt-8 block rounded-full px-4 py-2.5 text-center text-sm font-semibold transition-colors ${
								plan.id === "pro"
									? "bg-slate-900 text-white hover:bg-slate-700"
									: "border border-slate-300 text-slate-800 hover:border-slate-400"
							}`}
						>
							{plan.cta}
						</a>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>
